  "acceptance_cases": [
    {
      "id": "live_binding",
      "scenario": "PIDFD réel, tuple osay conforme, Id et InvocationID liés à l’objet listé.",
      "expected": "BINDING_RECORDED",
      "executed": false
    },
    {
      "id": "canonical_path",
      "scenario": "ID commençant par lettre puis chiffre : échappement canonique exact, chemins nommés/malformés refusés.",
      "expected": "CANONICAL_PATH_REQUIRED",
      "executed": false
    },
    {
      "id": "null_id",
      "scenario": "ID vide, tout nul, mauvaise longueur, booléen dans les octets : aucun appel de propriété.",
      "expected": "COLLECTION_REJECTED",
      "executed": false
    },
    {
      "id": "pidfd_unavailable",
      "scenario": "pidfd_open absent/refusé, FD non hérité ou mauvais type : aucun repli PID numérique ou chemin nommé.",
      "expected": "COLLECTION_REJECTED",
      "executed": false
    },
    {
      "id": "foreign_mapping",
      "scenario": "PID vivant dans une autre unité ou objet non listé : aucune propriété lue.",
      "expected": "COLLECTION_REJECTED",
      "executed": false
    },
    {
      "id": "unsupported_manager",
      "scenario": "API GetUnitByPIDFD absente, notamment profil v252 : inconnu/refus, aucun fallback.",
      "expected": "COLLECTION_REJECTED",
      "executed": false
    },
    {
      "id": "process_exit_or_reuse",
      "scenario": "Sortie du processus pointé par le FD ; une réutilisation du numéro ne rend pas ce FD valide.",
      "expected": "COLLECTION_REJECTED",
      "executed": false
    },
    {
      "id": "invocation_replaced",
      "scenario": "Même nom redémarré avec nouvelle invocation : ancienne adresse refusée, nouvelle non adoptée.",
      "expected": "COLLECTION_REJECTED",
      "executed": false
    },
    {
      "id": "removed_unit_no_load",
      "scenario": "Unité transitoire retirée entre acquisition et propriété : erreur et absence persistante dans ListUnits, sans chargement.",
      "expected": "NO_IMPLICIT_LOAD",
      "executed": false
    },
    {
      "id": "provenance_change",
      "scenario": "Bus, manager, boot, namespace ou listes changent : pas de reçu exploitable.",
      "expected": "COLLECTION_REJECTED",
      "executed": false
    },
    {
      "id": "finite_budgets",
      "scenario": "128 couples, FD, nombre exact d’appels, plafonds de flux/document et délai partagé.",
      "expected": "LIMITS_ENFORCED",
      "executed": false
    },
    {
      "id": "privacy",
      "scenario": "Rapport et erreurs sans PID, nom, chemin, ID ou stderr ; pas de lecture de commandes/environnement.",
      "expected": "PRIVATE_ENVELOPE_ONLY",
      "executed": false
    },
    {
      "id": "fd_lifetime",
      "scenario": "Seul le PIDFD voulu est transmis ; tous les FD fermés après succès/échec, aucun signal aux observés.",
      "expected": "FD_OWNERSHIP_ENFORCED",
      "executed": false
    },
    {
      "id": "unknown_coverage",
      "scenario": "Unités non sélectionnées, sans processus ou sans PID fourni gardées inconnues, aucun writer exclu.",
      "expected": "PARTIAL_UNKNOWN",
      "executed": false
    },
    {
      "id": "property_drift",
      "scenario": "Id/InvocationID contradictoires, mal typés ou modifiés entre passages.",
      "expected": "COLLECTION_REJECTED",
      "executed": false
    },
    {
      "id": "manager_pidref_fallback",
      "scenario": "Préconditions locales PIDFD conservées même si la copie interne du manager n’est pas attestable.",
      "expected": "NO_INTERNAL_FD_ATTESTATION",
      "executed": false
    }
