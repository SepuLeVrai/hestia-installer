FROM debian:13-slim
ENV DEBIAN_FRONTEND=noninteractive
RUN apt-get update -qq \
    && apt-get install -y --no-install-recommends python3 python3-venv chromium ca-certificates \
    && python3 -m venv /opt/browser-venv \
    && rm -rf /var/lib/apt/lists/* \
    && mkdir -p /evidence
COPY --chown=0:0 . /opt/hestia-installer
RUN /opt/browser-venv/bin/pip install --disable-pip-version-check -r /opt/hestia-installer/requirements-quality.txt
CMD ["sleep", "1800"]
