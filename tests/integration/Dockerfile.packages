ARG DEBIAN=13
FROM debian:${DEBIAN}-slim
ARG DEBIAN
ENV DEBIAN_FRONTEND=noninteractive container=docker
RUN printf '#!/bin/sh\nexit 101\n' > /usr/sbin/policy-rc.d \
    && chmod 0755 /usr/sbin/policy-rc.d \
    && apt-get update -qq \
    && apt-get install -y --no-install-recommends systemd-sysv python3 passwd util-linux ca-certificates \
    && if [ "${DEBIAN}" = 12 ]; then apt-get install -y --no-install-recommends dbus; fi \
    && rm -rf /var/lib/apt/lists/* \
    && mkdir -p /evidence
COPY --chown=0:0 . /opt/hestia-installer
STOPSIGNAL SIGRTMIN+3
CMD ["/sbin/init"]
